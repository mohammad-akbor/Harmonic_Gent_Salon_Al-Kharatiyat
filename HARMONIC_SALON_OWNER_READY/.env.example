# ==============================
# HARMONIC SALON — Environment
# ==============================
# Copy this file to .env.local and fill values.
# NEVER commit .env.local to GitHub.

# --- Database (MongoDB Atlas Free) ---
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/harmonic_salon?retryWrites=true&w=majority

# --- Auth ---
NEXTAUTH_SECRET=generate_a_long_random_string_here
NEXTAUTH_URL=http://localhost:3000
# After Vercel deploy change to: https://your-project.vercel.app

ADMIN_EMAIL=memohammadakborali@gmail.com
ADMIN_PASSWORD=Harmonic@4$
SALON_NAME=HARMONIC SALON

# --- Cloudinary (Images + Video) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=harmonic-salon

# --- Gmail SMTP (App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HARMONIC SALON <youremail@gmail.com>

# --- SMS (Twilio) ---
# Set to "twilio" to enable automatic SMS
SMS_PROVIDER=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+17372508034

# --- WhatsApp (optional) ---
# off | twilio | meta
WHATSAPP_PROVIDER=off
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Meta (if using official WhatsApp Cloud API)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
